<Window x:Class="OmpSyncClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OMP 多服务器配置与技能双向同步助手 (Windows Client)" Height="850" Width="1100"
        Background="#0F1117" Foreground="#E6EDF3" WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#21262D"/>
            <Setter Property="Foreground" Value="#E6EDF3"/>
            <Setter Property="BorderBrush" Value="#30363D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#30363D"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryBtn" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#1F6FEB"/>
            <Setter Property="BorderBrush" Value="#388BFD"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#388BFD"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SuccessBtn" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#238636"/>
            <Setter Property="BorderBrush" Value="#2EA043"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2EA043"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#0D1117"/>
            <Setter Property="Foreground" Value="#E6EDF3"/>
            <Setter Property="BorderBrush" Value="#30363D"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="CaretBrush" Value="#58A6FF"/>
        </Style>

        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="#E6EDF3"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,15,0"/>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Background" Value="#161B22"/>
            <Setter Property="Foreground" Value="#8B949E"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder" Background="{TemplateBinding Background}" BorderBrush="#30363D" BorderThickness="1,1,1,0" CornerRadius="6,6,0,0" Margin="0,0,4,0" Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#1C2128"/>
                                <Setter Property="Foreground" Value="#58A6FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Top Server Bar -->
            <RowDefinition Height="Auto"/> <!-- Shell Path Notice Card -->
            <RowDefinition Height="*"/>    <!-- Tabs for Config and Skills -->
            <RowDefinition Height="160"/>  <!-- Log Console -->
        </Grid.RowDefinitions>

        <!-- Top Server Bar -->
        <Border Grid.Row="0" Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Master 云端服务器:" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,10,0"/>
                <TextBox Grid.Column="1" x:Name="TxtServerUrl" Text="http://10.69.211.84:8900" Margin="0,0,10,0"/>
                <Button Grid.Column="2" x:Name="BtnTestConn" Content="测试连接" Click="BtnTestConn_Click" Margin="0,0,12,0"/>
                <TextBlock Grid.Column="3" x:Name="TxtConnStatus" Text="● 未测试" Foreground="#8B949E" VerticalAlignment="Center" FontWeight="Bold"/>
            </Grid>
        </Border>

        <!-- Shell Path Notice Card -->
        <Border Grid.Row="1" Background="#161B22" BorderBrush="#388BFD" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="🛡️ Windows Git Bash 路径隔离保护:" FontWeight="Bold" Foreground="#58A6FF" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock Grid.Column="1" x:Name="TxtDetectedBash" Text="正在检测本地 Git Bash..." Foreground="#7EE787" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="(上传自动剔除，拉取自动注入)" Foreground="#8B949E" FontSize="11" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Main Tab Control -->
        <TabControl Grid.Row="2" Background="#161B22" BorderBrush="#30363D" BorderThickness="1" Margin="0,0,0,10">
            
            <!-- TAB 1: CONFIG & MODELS SYNC -->
            <TabItem Header="📝 配置文件同步 (config.yml / models.yml)">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Switcher & Action bar -->
                        <RowDefinition Height="*"/>    <!-- Comparison split view -->
                    </Grid.RowDefinitions>

                    <!-- File Selector & Actions -->
                    <Border Grid.Row="0" Background="#1C2128" BorderBrush="#30363D" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,10">
                        <DockPanel LastChildFill="False">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="当前编辑文件:" VerticalAlignment="Center" Foreground="#8B949E" Margin="0,0,10,0"/>
                                <RadioButton x:Name="RbConfigFile" Content="config.yml (模型角色/主题/思考级别)" IsChecked="True" Checked="FileRadio_Checked"/>
                                <RadioButton x:Name="RbModelsFile" Content="models.yml (自定义 API Key 与模型)" Checked="FileRadio_Checked"/>
                            </StackPanel>

                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Content="📥 拉取当前文件" Style="{StaticResource PrimaryBtn}" Click="BtnPullCurrent_Click" Margin="0,0,8,0" ToolTip="仅拉取当前选择的文件"/>
                                <Button Content="📤 推送当前文件" Style="{StaticResource SuccessBtn}" Click="BtnPushCurrent_Click" Margin="0,0,12,0" ToolTip="仅推送当前选择的文件"/>
                                <Button Content="📥 拉取两者 (Both)" Click="BtnPullBoth_Click" Margin="0,0,8,0" ToolTip="同时拉取 config.yml 和 models.yml"/>
                                <Button Content="📤 推送两者 (Both)" Click="BtnPushBoth_Click" Margin="0,0,12,0" ToolTip="同时推送 config.yml 和 models.yml"/>
                                <Button Content="🔍 比对差异" Click="BtnDiff_Click"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- Split View -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Local Column -->
                        <Border Grid.Column="0" Background="#1C2128" BorderBrush="#30363D" BorderThickness="1" CornerRadius="6" Padding="10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <DockPanel Grid.Row="0" Margin="0,0,0,6">
                                    <TextBlock x:Name="TxtLocalTitle" Text="💻 本机配置" FontWeight="Bold" FontSize="13" Foreground="#58A6FF"/>
                                    <Button DockPanel.Dock="Right" Content="刷新本地" Click="BtnRefreshLocal_Click" Padding="6,2" FontSize="11"/>
                                </DockPanel>
                                <TextBox Grid.Row="1" x:Name="TxtLocalConfig" FontFamily="Consolas, monospace" FontSize="12" AcceptsReturn="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
                            </Grid>
                        </Border>

                        <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="Transparent"/>

                        <!-- Remote Column -->
                        <Border Grid.Column="2" Background="#1C2128" BorderBrush="#30363D" BorderThickness="1" CornerRadius="6" Padding="10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <DockPanel Grid.Row="0" Margin="0,0,0,6">
                                    <TextBlock x:Name="TxtRemoteTitle" Text="☁️ 云端 Master 配置" FontWeight="Bold" FontSize="13" Foreground="#7EE787"/>
                                    <Button DockPanel.Dock="Right" Content="刷新云端" Click="BtnRefreshRemote_Click" Padding="6,2" FontSize="11"/>
                                </DockPanel>
                                <TextBox Grid.Row="1" x:Name="TxtRemoteConfig" FontFamily="Consolas, monospace" FontSize="12" AcceptsReturn="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- TAB 2: SELECTIVE SKILLS SYNC -->
            <TabItem Header="🧩 技能选择性同步 (Skills 管理)">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Action bar -->
                        <RowDefinition Height="*"/>    <!-- DataGrid of skills -->
                    </Grid.RowDefinitions>

                    <!-- Skills Action Bar -->
                    <Border Grid.Row="0" Background="#1C2128" BorderBrush="#30363D" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,10">
                        <DockPanel LastChildFill="False">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="🔄 刷新列表" Click="BtnRefreshSkills_Click" Margin="0,0,8,0"/>
                                <Button Content="☑️ 全选" Click="BtnSelectAllSkills_Click" Margin="0,0,6,0"/>
                                <Button Content="⬜ 全不选" Click="BtnDeselectAllSkills_Click" Margin="0,0,14,0"/>
                                <TextBlock x:Name="TxtSkillsSummary" Text="共检测到 0 个技能" VerticalAlignment="Center" Foreground="#8B949E" FontSize="12"/>
                            </StackPanel>

                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Content="📤 上传所选技能到云端" Style="{StaticResource SuccessBtn}" Click="BtnUploadSelectedSkills_Click" Margin="0,0,10,0" ToolTip="将勾选的本地技能打包上传至云端并触发集群广播"/>
                                <Button Content="📥 从云端下载所选技能" Style="{StaticResource PrimaryBtn}" Click="BtnDownloadSelectedSkills_Click" ToolTip="从云端下载勾选的技能并解压到本机 skills/ 目录"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- Skills DataGrid -->
                    <Border Grid.Row="1" Background="#1C2128" BorderBrush="#30363D" BorderThickness="1" CornerRadius="6" Padding="4">
                        <DataGrid x:Name="DgSkills" AutoGenerateColumns="False" CanUserAddRows="False"
                                  Background="#1C2128" RowBackground="#161B22" AlternatingRowBackground="#1C2128"
                                  Foreground="#E6EDF3" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#30363D"
                                  BorderThickness="0" HeadersVisibility="Column" FontSize="12">
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#21262D"/>
                                    <Setter Property="Foreground" Value="#E6EDF3"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Padding" Value="8,6"/>
                                    <Setter Property="BorderBrush" Value="#30363D"/>
                                    <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                </Style>
                            </DataGrid.ColumnHeaderStyle>

                            <DataGrid.Columns>
                                <!-- Checkbox Column -->
                                <DataGridCheckBoxColumn Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="45">
                                    <DataGridCheckBoxColumn.ElementStyle>
                                        <Style TargetType="CheckBox">
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridCheckBoxColumn.ElementStyle>
                                </DataGridCheckBoxColumn>

                                <!-- Skill Name -->
                                <DataGridTextColumn Header="Skill 名称" Binding="{Binding Name}" FontWeight="Bold" Width="180"/>

                                <!-- Description -->
                                <DataGridTextColumn Header="功能描述" Binding="{Binding Description}" Width="*"/>

                                <!-- Local Status -->
                                <DataGridTemplateColumn Header="本地状态 (Windows)" Width="150">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding LocalStatusText}" Foreground="{Binding LocalStatusColor}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="6,0"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Remote Status -->
                                <DataGridTemplateColumn Header="云端状态 (10.69.211.84)" Width="150">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding RemoteStatusText}" Foreground="{Binding RemoteStatusColor}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="6,0"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Action Buttons -->
                                <DataGridTemplateColumn Header="单个操作" Width="150">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <Button Content="📤 上传" Click="BtnUploadSingleSkill_Click" Tag="{Binding}" Margin="0,0,6,0" Padding="6,2" FontSize="11" IsEnabled="{Binding CanUpload}"/>
                                                <Button Content="📥 下载" Click="BtnDownloadSingleSkill_Click" Tag="{Binding}" Padding="6,2" FontSize="11" IsEnabled="{Binding CanDownload}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Log Console Area -->
        <Border Grid.Row="3" Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="8" Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" Margin="0,0,0,6">
                    <TextBlock Text="📜 实时操作日志" FontWeight="Bold" FontSize="13" Foreground="#8B949E" VerticalAlignment="Center"/>
                    <Button DockPanel.Dock="Right" Content="清空日志" Click="BtnClearLog_Click" Padding="8,2" FontSize="11"/>
                </DockPanel>
                <TextBox Grid.Row="1" x:Name="TxtLogs" FontFamily="Consolas, monospace" FontSize="12" Background="#0D1117" Foreground="#C9D1D9" IsReadOnly="True" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
            </Grid>
        </Border>
    </Grid>
</Window>
